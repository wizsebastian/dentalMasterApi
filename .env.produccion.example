# Copiar a .env en el servidor y rellenar. NUNCA se versiona.

# Contraseña de la base. Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=

# Firma de los JWT. Generar con: openssl rand -hex 32
# Cambiarla invalida todas las sesiones abiertas.
SECRET_KEY=

# Orígenes permitidos, separados por coma. Sin espacios.
CORS_ORIGINS=https://dentalmaster.wizsebastian.com

DEBUG=false
# En producción no se siembran usuarios demo: se crean con app.cli.
SEED_DEMO_USERS=false
